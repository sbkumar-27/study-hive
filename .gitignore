# === Secrets / environment ===
.env
.env.*
!.env.example
*.pem
*.key

# === Java / Maven ===
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties

# === JavaFX / IDE ===
*.hprof

# === Node / React (web) ===
web/node_modules/
web/dist/
web/dist-ssr/
web/*.local
web/coverage/
web/.vite/

# === Uploaded files (never commit user content) ===
# NOTE: these must stay anchored (contain a "/" in the middle) -- a bare
# "storage/" or "uploads/" pattern matches a directory with that name at
# ANY depth, including backend/.../storage, the Java *source* package for
# the storage provider interface, silently excluding it from git.
/backend/storage/
/backend/uploads/
/backend/build-test-storage/

# === Logs ===
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# === OS / editor ===
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml
*.swp

# === Test / build artifacts ===
backend/target/
desktop/target/
coverage/
