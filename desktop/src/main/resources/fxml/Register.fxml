<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.studyhive.desktop.controller.RegisterController"
           styleClass="page-root">
    <VBox styleClass="card" maxWidth="420" spacing="12" alignment="CENTER_LEFT">
        <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>
        <Label text="Create your account" styleClass="h1"/>

        <VBox fx:id="errorBox" styleClass="alert-banner" visible="false" managed="false">
            <Label fx:id="errorLabel" styleClass="alert-banner-text" wrapText="true"/>
        </VBox>

        <VBox spacing="4">
            <Label text="Display name" styleClass="field-label"/>
            <TextField fx:id="displayNameField"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Username" styleClass="field-label"/>
            <TextField fx:id="usernameField"/>
            <Label text="Letters, numbers, dots, dashes, or underscores only." styleClass="hint"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Email" styleClass="field-label"/>
            <TextField fx:id="emailField"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Password" styleClass="field-label"/>
            <PasswordField fx:id="passwordField"/>
            <Label text="At least 8 characters." styleClass="hint"/>
        </VBox>

        <Button fx:id="registerButton" text="Create account" styleClass="button-primary" maxWidth="Infinity" onAction="#handleRegister"/>

        <HBox spacing="4" alignment="CENTER_LEFT">
            <Label text="Already have an account?" styleClass="muted"/>
            <Hyperlink text="Log in" onAction="#handleGoToLogin"/>
        </HBox>
    </VBox>
</StackPane>
