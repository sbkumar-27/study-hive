<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.studyhive.desktop.controller.MaterialsController"
      spacing="16" styleClass="page-root">
    <padding><Insets top="20" right="24" bottom="24" left="24"/></padding>

    <HBox alignment="CENTER_LEFT">
        <Label text="Materials" styleClass="h1"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Upload material" styleClass="button-primary" onAction="#handleUpload"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Search title, book, author, subject..." prefWidth="280"/>
        <ComboBox fx:id="typeCombo" prefWidth="160"/>
        <ComboBox fx:id="sortCombo" prefWidth="150"/>
    </HBox>

    <Label fx:id="statusLabel" styleClass="muted"/>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane">
        <FlowPane fx:id="cardsContainer" hgap="16" vgap="16"/>
    </ScrollPane>

    <HBox spacing="12" alignment="CENTER">
        <Button fx:id="prevButton" text="Previous" onAction="#handlePrevPage"/>
        <Label fx:id="pageLabel" styleClass="muted text-sm"/>
        <Button fx:id="nextButton" text="Next" onAction="#handleNextPage"/>
    </HBox>
</VBox>
