<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.studyhive.desktop.controller.ReportsController"
      spacing="16" styleClass="page-root">
    <padding><Insets top="20" right="24" bottom="24" left="24"/></padding>

    <Label text="Pending reports" styleClass="h1"/>
    <Label text="Shows all pending reports if you're an admin, or reports for communities you own/moderate otherwise."
           styleClass="hint" wrapText="true"/>

    <Label fx:id="statusLabel" styleClass="muted"/>

    <TableView fx:id="reportsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="materialColumn" text="Material" prefWidth="220"/>
            <TableColumn fx:id="reporterColumn" text="Reported by" prefWidth="120"/>
            <TableColumn fx:id="reasonColumn" text="Reason" prefWidth="220"/>
            <TableColumn fx:id="dateColumn" text="Date" prefWidth="110"/>
            <TableColumn fx:id="actionsColumn" text="" prefWidth="220"/>
        </columns>
    </TableView>

    <HBox spacing="12" alignment="CENTER">
        <Button fx:id="prevButton" text="Previous" onAction="#handlePrevPage"/>
        <Label fx:id="pageLabel" styleClass="muted text-sm"/>
        <Button fx:id="nextButton" text="Next" onAction="#handleNextPage"/>
    </HBox>
</VBox>
