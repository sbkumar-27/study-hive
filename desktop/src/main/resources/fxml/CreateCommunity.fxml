<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.studyhive.desktop.controller.CreateCommunityController"
      spacing="16" styleClass="page-root">
    <padding><Insets top="20" right="24" bottom="24" left="24"/></padding>

    <Label text="Create a community" styleClass="h1"/>

    <VBox styleClass="card" spacing="12" maxWidth="520">
        <VBox fx:id="errorBox" styleClass="alert-banner" visible="false" managed="false">
            <Label fx:id="errorLabel" styleClass="alert-banner-text" wrapText="true"/>
        </VBox>

        <VBox spacing="4">
            <Label text="Name" styleClass="field-label"/>
            <TextField fx:id="nameField"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Description (optional)" styleClass="field-label"/>
            <TextArea fx:id="descriptionField" prefRowCount="3" wrapText="true"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Visibility" styleClass="field-label"/>
            <ComboBox fx:id="typeCombo" maxWidth="Infinity"/>
        </VBox>
        <VBox fx:id="passwordBox" spacing="4" visible="false" managed="false">
            <Label text="Password (optional, extra layer beyond the join code)" styleClass="field-label"/>
            <PasswordField fx:id="passwordField"/>
        </VBox>

        <Button fx:id="createButton" text="Create community" styleClass="button-primary" onAction="#handleCreate"/>
    </VBox>
</VBox>
