# Copy to .env.local for local overrides (Vite loads .env.local automatically). Never commit it.
# Leave unset locally -- the app defaults to http://localhost:8080.
#
# On Vercel, set this to the deployed Render backend's origin (no trailing slash, no /api/v1):
# VITE_API_BASE_URL=https://studyhive-backend.onrender.com
VITE_API_BASE_URL=
