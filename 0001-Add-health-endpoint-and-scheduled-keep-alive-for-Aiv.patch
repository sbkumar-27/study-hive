---
 .github/workflows/keep-alive.yml              | 27 ++++++++++++++
 .../backend/config/SecurityConfig.java        |  1 +
 .../backend/controller/HealthController.java  | 37 +++++++++++++++++++
 3 files changed, 65 insertions(+)
 create mode 100644 .github/workflows/keep-alive.yml
 create mode 100644 backend/src/main/java/com/studyhive/backend/controller/HealthController.java

diff --git a/.github/workflows/keep-alive.yml b/.github/workflows/keep-alive.yml
new file mode 100644
index 0000000..1f61d27
--- /dev/null
+++ b/.github/workflows/keep-alive.yml
@@ -0,0 +1,27 @@
+name: Keep Aiven database awake
+
+on:
+  schedule:
+    # Every 3 hours (GitHub cron runs in UTC and may start a few minutes late).
+    - cron: "17 */3 * * *"
+  workflow_dispatch: # lets you run it by hand from the Actions tab
+
+jobs:
+  ping:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Ping backend health endpoint (wakes Render, queries Aiven)
+        env:
+          BACKEND_URL: ${{ vars.BACKEND_URL }}
+        run: |
+          if [ -z "$BACKEND_URL" ]; then
+            echo "BACKEND_URL repository variable is not set"; exit 1
+          fi
+          # Render's free tier can take ~1 minute to wake up, so allow retries.
+          for i in 1 2 3 4 5; do
+            if curl -fsS --max-time 90 "$BACKEND_URL/api/v1/health"; then
+              echo; echo "Database is awake."; exit 0
+            fi
+            echo "Attempt $i failed, retrying in 30s..."; sleep 30
+          done
+          echo "Health check failed - check Aiven and Render dashboards."; exit 1
diff --git a/backend/src/main/java/com/studyhive/backend/config/SecurityConfig.java b/backend/src/main/java/com/studyhive/backend/config/SecurityConfig.java
index 0257994..1dceac8 100644
--- a/backend/src/main/java/com/studyhive/backend/config/SecurityConfig.java
+++ b/backend/src/main/java/com/studyhive/backend/config/SecurityConfig.java
@@ -47,6 +47,7 @@ public class SecurityConfig {
                 .sessionManagement(session -> session.sessionCreationPolicy(SessionCreationPolicy.STATELESS))
                 .authorizeHttpRequests(auth -> auth
                         .requestMatchers("/api/v1/auth/**").permitAll()
+                        .requestMatchers("/api/v1/health").permitAll()
                         .anyRequest().authenticated())
                 .exceptionHandling(handling -> handling
                         .authenticationEntryPoint(authEntryPoint)
diff --git a/backend/src/main/java/com/studyhive/backend/controller/HealthController.java b/backend/src/main/java/com/studyhive/backend/controller/HealthController.java
new file mode 100644
index 0000000..67fbaaf
--- /dev/null
+++ b/backend/src/main/java/com/studyhive/backend/controller/HealthController.java
@@ -0,0 +1,37 @@
+package com.studyhive.backend.controller;
+
+import java.time.Instant;
+import java.util.Map;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+/**
+ * Public keep-alive endpoint. A scheduled job calls it every few hours so that
+ * Render wakes the backend and the backend runs a tiny query against Aiven,
+ * keeping the free-tier database from being powered off for inactivity.
+ */
+@RestController
+@RequestMapping("/api/v1/health")
+public class HealthController {
+
+    private final JdbcTemplate jdbcTemplate;
+
+    public HealthController(JdbcTemplate jdbcTemplate) {
+        this.jdbcTemplate = jdbcTemplate;
+    }
+
+    @GetMapping
+    public ResponseEntity<Map<String, Object>> health() {
+        try {
+            jdbcTemplate.queryForObject("SELECT 1", Integer.class);
+            return ResponseEntity.ok(Map.of("status", "UP", "database", "UP", "time", Instant.now().toString()));
+        } catch (Exception e) {
+            return ResponseEntity.status(HttpStatus.SERVICE_UNAVAILABLE)
+                    .body(Map.of("status", "DOWN", "database", "DOWN", "time", Instant.now().toString()));
+        }
+    }
+}
