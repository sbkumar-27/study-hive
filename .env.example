# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=studyhive
DB_USERNAME=root
DB_PASSWORD=password
# REQUIRED (default) works for managed hosts like Aiven with no extra setup.
# Use DISABLED for plain local MySQL with no TLS, or VERIFY_CA/VERIFY_IDENTITY
# if the host needs strict certificate verification (needs a truststore).
DB_SSL_MODE=REQUIRED

# --- JWT auth ---
# Generate a long random value, e.g.: openssl rand -base64 64
JWT_SECRET=replace-with-a-long-random-base64-secret
JWT_EXPIRATION_MS=86400000

# --- File storage ---
# local (default), or supabase
STORAGE_PROVIDER=local
# Absolute path on disk where uploaded material files are stored (provider=local).
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_MB=25

# --- Supabase Storage (only needed if STORAGE_PROVIDER=supabase) ---
# Service-role key from the Supabase project's API settings; never commit real values.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=

# --- CORS (web dev server) ---
WEB_APP_ORIGIN=http://localhost:5173

# --- Server ---
SERVER_PORT=8080
