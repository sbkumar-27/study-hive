# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=studyhive
DB_USERNAME=root
DB_PASSWORD=changeme

# --- JWT auth ---
# Generate a long random value, e.g.: openssl rand -base64 64
JWT_SECRET=replace-with-a-long-random-base64-secret
JWT_EXPIRATION_MS=86400000

# --- File storage ---
# Absolute path on disk where uploaded material files are stored.
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_MB=25

# --- CORS (web dev server) ---
WEB_APP_ORIGIN=http://localhost:5173

# --- Server ---
SERVER_PORT=8080
