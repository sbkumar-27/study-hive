# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=studyhive
DB_USERNAME=root
DB_PASSWORD=changeme

# --- JWT auth ---
# Generate a long random value, e.g.: openssl rand -base64 64
JWT_SECRET=replace-with-a-long-random-base64-secret
JWT_EXPIRATION_MS=86400000

# --- File storage ---
# local (default) or catalyst
STORAGE_PROVIDER=local
# Absolute path on disk where uploaded material files are stored (provider=local).
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_MB=25

# --- Zoho Catalyst File Store (only needed if STORAGE_PROVIDER=catalyst) ---
# OAuth self-client credentials from the Catalyst console; never commit real values.
CATALYST_CLIENT_ID=
CATALYST_CLIENT_SECRET=
CATALYST_REFRESH_TOKEN=
CATALYST_PROJECT_ID=
CATALYST_PROJECT_KEY=
CATALYST_DOMAIN=catalyst.zoho.com
CATALYST_ENVIRONMENT=Production
CATALYST_FOLDER_ID=

# --- CORS (web dev server) ---
WEB_APP_ORIGIN=http://localhost:5173

# --- Server ---
SERVER_PORT=8080
